{
  "name": "aiconnect-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-frontend.mjs && node scripts/stage.mjs",
    "dev": "npm run build && python scripts/preview-local.py",
    "check": "node --check src/worker.js && node --check public/site.js && node --check scripts/stage.mjs",
    "test": "node --test test/*.test.mjs",
    "test:local": "node scripts/test-local.mjs",
    "bundle:check": "npm run build && wrangler deploy --dry-run --outdir .local/worker-bundle"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "0.28.2",
    "skills": "1.7.4",
    "wrangler": "4.155.0"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.65.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  }
}
