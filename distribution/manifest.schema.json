{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIConnect release manifest",
  "type": "object",
  "required": [
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "payload": {
      "type": "object",
      "required": [
        "schemaVersion",
        "version",
        "artifacts"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        },
        "artifacts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(windows|linux|macos)-(x86_64|aarch64)$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "url",
              "sha256",
              "size",
              "format",
              "fileName"
            ],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 104857600
              },
              "format": {
                "const": "binary"
              },
              "fileName": {
                "enum": [
                  "aiconnect",
                  "aiconnect.exe"
                ]
              },
              "chunks": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "size",
                  "sha256"
                ],
                "properties": {
                  "size": {
                    "type": "integer",
                    "minimum": 65536,
                    "maximum": 4194304
                  },
                  "sha256": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1600,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "required": [
        "algorithm",
        "keyId",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "keyId": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}
